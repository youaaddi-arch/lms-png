# Copie ce fichier vers ".env" et remplis les valeurs.
# NE JAMAIS committer le vrai fichier .env (il est ignoré par git).

# URL de base de ton Moodle (sans / final)
MOODLE_URL=https://mon-moodle.parisnordgroupe.fr

# Token de Web Service (PAS ton mot de passe !)
# Voir le README : Administration du site > Serveur > Services web > Gérer les jetons
MOODLE_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
